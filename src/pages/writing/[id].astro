---
import { render, type CollectionEntry } from "astro:content";
import SiteLayout from "../../layouts/SiteLayout.astro";
import { siteConfig } from "../../site.config";
import { contentKey, displayDate, getProjects, getWriting, htmlDate, projectHref, writingHref } from "../../lib/content";
import { absoluteUrl, articleStructuredData } from "../../lib/seo";
import EditorialText from "../../components/EditorialText.astro";

export async function getStaticPaths() {
  const writing = await getWriting();
  return writing.map((entry) => ({ params: { id: contentKey(entry) }, props: { entry } }));
}

interface Props { entry: CollectionEntry<"writing">; }
const { entry } = Astro.props;
const { Content } = await render(entry);
const projects = await getProjects();
const chineseEntry = (await getWriting("zh")).find((candidate) => contentKey(candidate) === contentKey(entry));
const relatedProjects = entry.data.relatedProjects
  .map((id) => projects.find((project) => contentKey(project) === id))
  .filter((project): project is CollectionEntry<"projects"> => Boolean(project));
const internalUrl = absoluteUrl(writingHref(contentKey(entry)));
const canonicalUrl = entry.data.canonicalUrl ?? internalUrl;
const structuredData = articleStructuredData({
  title: entry.data.title,
  summary: entry.data.summary,
  url: canonicalUrl,
  date: entry.data.date,
  updated: entry.data.updated,
  tags: entry.data.tags,
  locale: "en"
});
---
<SiteLayout
  title={`${entry.data.title} — ${siteConfig.name}`}
  description={entry.data.summary}
  routeKind="writing"
  routeId={contentKey(entry)}
  canonicalUrl={canonicalUrl}
  ogType="article"
  structuredData={structuredData}
  alternatePaths={chineseEntry ? { en: writingHref(contentKey(entry)), zh: writingHref(contentKey(entry), "zh") } : { en: writingHref(contentKey(entry)) }}
>
  <header class="article-head page" data-writing-slug={contentKey(entry)}>
    <div class="article-head__meta">
      <span class="eyebrow">{entry.data.kind}</span>
      <time class="meta" datetime={htmlDate(entry.data.date)}>{displayDate(entry.data.date)}</time>
    </div>
    <div class="article-head__title-slot" data-vt-writing-title>
      <h1 class="article-head__title" data-editorial-role="display"><EditorialText text={entry.data.title} locale="en" role="display" breakHints={entry.data.displayBreakHints} /></h1>
    </div>
    <p class="article-head__dek" data-editorial-role="intro"><EditorialText text={entry.data.summary} locale="en" role="intro" /></p>
    {relatedProjects.length > 0 && (
      <div class="article-head__relations meta">
        Related /
        {relatedProjects.map((project, index) => (
          <><a href={projectHref(contentKey(project))}>{project.data.title}</a>{index < relatedProjects.length - 1 ? " / " : ""}</>
        ))}
      </div>
    )}
  </header>

  <div class="page article-body">
    <article class="prose reading"><Content /></article>
  </div>
</SiteLayout>
