---
import SiteLayout from "../../layouts/SiteLayout.astro";
import SelectedWorkFan from "../../components/SelectedWorkFan.astro";
import LatestWriting from "../../components/LatestWriting.astro";
import Icon from "../../components/Icon.astro";
import { siteConfig } from "../../site.config";
import { getContentIndex, latestWriting, projectTitleMap, selectedProjects } from "../../lib/content";
import EditorialText from "../../components/EditorialText.astro";

const { projects, listedProjects, writing } = await getContentIndex("zh");
const selected = selectedProjects(listedProjects, siteConfig.home.selectedProjects);
const latest = latestWriting(writing, siteConfig.home.latestWriting);
const projectTitles = projectTitleMap(projects);
---
<SiteLayout
  locale="zh"
  routeKind="home"
  alternatePaths={{ en: "/", zh: "/zh/" }}
>
  <section class="home-field dot-field dot-field--home" aria-labelledby="hero-title">
    <div class="page home-field__inner">
      <div class="home-intro">
        <h1 id="hero-title" class="display" data-editorial-role="display"><EditorialText text={siteConfig.locales.zh.hero.title} locale="zh" role="display" breakHints={siteConfig.locales.zh.hero.displayBreakHints} /></h1>
        <p class="home-intro__lede" data-editorial-role="intro"><EditorialText text={siteConfig.locales.zh.hero.lede} locale="zh" role="intro" /></p>
        <div class="home-intro__links meta">
          <a class="home-intro__timeline-link" href="/zh/timeline/" aria-label="時間線">
            <span class="home-intro__link-label">時間線</span>
            <span class="home-intro__link-arrow" aria-hidden="true"><Icon name="arrow-up-right" /></span>
          </a>
        </div>
      </div>
      <SelectedWorkFan projects={selected} locale="zh" />
    </div>
    <a class="home-field__scroll" href="#latest-writing" aria-label="跳至最新文章"><Icon name="arrow-down" /></a>
  </section>

  <LatestWriting items={latest} projectTitles={projectTitles} locale="zh" />
</SiteLayout>
