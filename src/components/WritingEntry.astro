---
import type { WritingEntry as WritingContentEntry } from "../lib/content";
import { contentKey, displayDate, htmlDate, writingHref } from "../lib/content";
import type { SiteLocale } from "../lib/i18n";
import EditorialText from "./EditorialText.astro";
import Icon from "./Icon.astro";
import ChronologyRail from "./ChronologyRail.astro";

interface Props {
  item: WritingContentEntry;
  projectTitles?: Record<string, string>;
  headingLevel?: 2 | 3;
  latestRank?: number;
  sequenceEnd?: boolean;
  locale?: SiteLocale;
}

const {
  item,
  projectTitles = {},
  headingLevel = 3,
  latestRank,
  sequenceEnd = false,
  locale = "en"
} = Astro.props;

const related = item.data.relatedProjects
  .map((id) => projectTitles[id] ?? id)
  .join(" / ");
---
<a
  class:list={["writing-entry", sequenceEnd && "writing-entry--sequence-end"]}
  href={writingHref(contentKey(item), locale)}
  data-writing-slug={contentKey(item)}
  data-latest-rank={latestRank}
>
  <time class="writing-entry__date meta" datetime={htmlDate(item.data.date)}>{displayDate(item.data.date)}</time>
  <span class="writing-entry__rail" aria-hidden="true"><ChronologyRail class="writing-entry__rail-line" /></span>
  <div class="writing-entry__copy">
    <span class="writing-entry__kicker meta">{item.data.kind}</span>
    <div class="writing-entry__title-row">
      {headingLevel === 2 ? <h2 data-vt-writing-title data-editorial-role="display"><EditorialText text={item.data.title} locale={locale} role="display" breakHints={item.data.displayBreakHints} /></h2> : <h3 data-vt-writing-title data-editorial-role="display"><EditorialText text={item.data.title} locale={locale} role="display" breakHints={item.data.displayBreakHints} /></h3>}
      <span class="writing-entry__arrow" aria-hidden="true"><Icon name="arrow-up-right" /></span>
    </div>
    <p data-editorial-role="compact"><EditorialText text={item.data.summary} locale={locale} role="compact" /></p>
    {related && <span class="writing-entry__meta meta">Related / {related}</span>}
  </div>
</a>
