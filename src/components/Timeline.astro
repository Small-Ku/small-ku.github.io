---
import FilterSwitch from "./FilterSwitch.astro";
import ProjectVisual from "./ProjectVisual.astro";
import WritingEntry from "./WritingEntry.astro";
import ContinuationRow from "./ContinuationRow.astro";
import Icon from "./Icon.astro";
import ChronologyRail from "./ChronologyRail.astro";
import type { TimelineItem } from "../lib/content";
import { contentKey, displayDate, htmlDate } from "../lib/content";
import type { SiteLocale } from "../lib/i18n";
import EditorialText from "./EditorialText.astro";

interface Props {
  items: TimelineItem[];
  latestWritingIds?: string[];
  projectTitles?: Record<string, string>;
  locale?: SiteLocale;
}

const { items, latestWritingIds = [], projectTitles = {}, locale = "en" } = Astro.props;
const latestRankById = new Map(latestWritingIds.map((id, index) => [id, index + 1]));
const timelineTitle = locale === "zh"
  ? "\u6301\u7e8c\u767c\u5c55\u4e2d\u7684\u4f5c\u54c1\uff0c\u4ee5\u53ca\u570d\u7e5e\u5b83\u5011\u7684\u7b46\u8a18\u3002"
  : "Work in motion, and the notes around it.";
const filterOptions = [
  { value: "all", label: locale === "zh" ? "全部" : "All" },
  { value: "writing", label: locale === "zh" ? "文章" : "Writing" },
  { value: "work", label: locale === "zh" ? "作品" : "Projects" }
];
---
<section
  class="timeline-section page"
  id="timeline"
  aria-labelledby="timeline-title"
  data-timeline
  data-vt-timeline-destination
>
  <span class="timeline-section__transition-surface" data-vt-timeline-surface aria-hidden="true"></span>
  <div class="timeline-head">
    <div>
      <p class="eyebrow">{locale === "zh" ? "時間線／按時間排序" : "Timeline / chronological"}</p>
      <h1 id="timeline-title" data-editorial-role="display"><EditorialText text={timelineTitle} locale={locale} role="display" /></h1>
    </div>
    {items.length > 0 && <FilterSwitch options={filterOptions} active="all" label={locale === "zh" ? "篩選時間線" : "Filter timeline"} />}
  </div>

  {items.length > 0 ? (
    <div class="timeline-list" data-timeline-list>
      <span class="timeline-origin" data-vt-timeline-start aria-hidden="true"></span>

      {items.map((item, index) => (
        item.type === "writing" ? (
          <div
            class="timeline-entry timeline-entry--writing"
            data-timeline-type="writing"
            data-latest-rank={latestRankById.get(item.writing.id)}
          >
            <WritingEntry
              item={item.writing}
              projectTitles={projectTitles}
              headingLevel={2}
              latestRank={latestRankById.get(item.id)}
              sequenceEnd={index === items.length - 1}
              locale={locale}
            />
          </div>
        ) : (
          <div
            class:list={[
              "timeline-entry",
              "timeline-entry--work",
              `timeline-entry--tone-${item.project.data.tone}`,
              item.project.data.visual && "timeline-entry--has-visual"
            ]}
            data-timeline-type="work"
          >
            <ChronologyRail class="timeline-entry__rail-line" />
            <time class="timeline-entry__date meta" datetime={htmlDate(item.date)}>{displayDate(item.date)}</time>
            <a
              class="timeline-entry__content"
              href={item.href}
              data-work-slug={contentKey(item.project)}
              data-vt-project-origin
            >
              <span class="timeline-entry__transition-surface" data-vt-project-surface aria-hidden="true"></span>
              {item.project.data.visual ? (
                <div class="timeline-entry__visual" data-vt-project-visual>
                  <ProjectVisual
                    tone={item.project.data.tone}
                    variant={item.project.data.visual.variant}
                    label={item.project.data.visual.label}
                    alt={item.project.data.visual.alt}
                  />
                </div>
              ) : (
                <span class="timeline-entry__band" aria-hidden="true"></span>
              )}
              <div class="timeline-entry__copy">
                <span class="timeline-entry__kicker meta">Project / {item.project.data.kicker} · {item.project.data.status}</span>
                <div class="timeline-entry__title-row">
                  <div class="timeline-entry__title-slot" data-vt-project-title><h2 data-editorial-role="display"><EditorialText text={item.project.data.title} locale={locale} role="display" breakHints={item.project.data.displayBreakHints} /></h2></div>
                  <span class="timeline-entry__arrow" aria-hidden="true"><Icon name="arrow-up-right" /></span>
                </div>
                <p data-editorial-role="compact"><EditorialText text={item.project.data.summary} locale={locale} role="compact" /></p>
                <span class="timeline-entry__meta meta">{item.project.data.visibility}</span>
              </div>
            </a>
          </div>
        )
      ))}

      <ContinuationRow label={locale === "zh" ? "結束" : "End"} terminal={true} />
    </div>
  ) : (
    <div class="timeline-empty" role="status">
      <p>{locale === "zh" ? "尚未發布內容。" : "Nothing published yet."}</p>
    </div>
  )}
</section>
