---
interface Props {
  name: "language" | "appearance" | "arrow-up-right" | "arrow-down";
  class?: string;
}

const { name, class: className } = Astro.props;
---
<svg
  class:list={["icon", className]}
  viewBox="0 0 24 24"
  aria-hidden="true"
  focusable="false"
  data-icon={name}
>
  {name === "language" ? (
    <>
      <circle cx="12" cy="12" r="9"></circle>
      <path d="M3.6 9h16.8M3.6 15h16.8M12 3c2.2 2.45 3.3 5.45 3.3 9S14.2 18.55 12 21M12 3C9.8 5.45 8.7 8.45 8.7 12S9.8 18.55 12 21"></path>
    </>
  ) : name === "appearance" ? (
    <>
      <circle cx="12" cy="12" r="9"></circle>
      <path class="icon__fill" d="M12 3a9 9 0 0 0 0 18V3Z"></path>
    </>
  ) : name === "arrow-up-right" ? (
    <path d="M5 19 19 5M9 5h10v10"></path>
  ) : (
    <path d="M12 4.5v15M6.5 14 12 19.5 17.5 14"></path>
  )}
</svg>
