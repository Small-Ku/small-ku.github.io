    "build:integrity": "astro build --config tests/integrity.config.mjs",
    "stats": "node scripts/output-stats.mjs"
  },
  "dependencies": {
    "astro": "7.3.3",
    "sass": "1.104.1"
  },
  "devDependencies": {
    "@astrojs/compiler-rs": "0.4.1",
    "@astrojs/check": "0.9.10",
    "@playwright/test": "1.58.2",
    "lightningcss": "1.33.0",
    "parse5": "8.0.0",
    "typescript": "6.0.3",
    "vite": "8.3.0"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
