{
  "name": "small-ku-personal-site",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.4.2",
  "scripts": {
    "dev": "astro dev",
    "build": "astro check && astro build",
    "preview": "astro preview",
    "check": "astro check",
    "test:punctuation": "node --experimental-strip-types --test tests/editorial-punctuation.test.mjs",
    "test:punctuation:browser": "node --experimental-strip-types tests/editorial-punctuation-browser.mjs",
    "test:transition-ownership:browser": "node tests/editorial-transition-ownership-browser.mjs"
  },
  "dependencies": {
    "astro": "7.3.3",
    "budoux": "0.9.3",
    "sass": "1.104.1"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@astrojs/markdown-remark": "7.3.1",
    "hyphen": "1.14.1",
    "typescript": "6.0.3"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
